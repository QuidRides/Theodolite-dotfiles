<style-scheme id="theodolite" _name="Theodolite" version="1.0">
  <author>mrwild</author>
  <_description>Color scheme using Theodolite color palette</_description>

  <!-- Theodolite palette -->
  <color name="brass1"                      value="#F5DA91"/>
  <color name="brass2"                      value="#EAB63E"/>
  <color name="phthalo1"                    value="#2C9C77"/>
  <color name="phthalo2"                    value="#0A6C4C"/>
  <color name="dutch1"                      value="#E19439"/>
  <color name="dutch2"                      value="#CF8126"/>
  <color name="prussian1"                   value="#4A73C1"/>
  <color name="prussian2"                   value="#355EAD"/>
  <color name="tyre1"                       value="#533484"/>
  <color name="tyre2"                       value="#371C62"/>
  <color name="acajou1"                     value="#5D2F0B"/>
  <color name="acajou2"                     value="#3B1B02"/>
  <color name="rouge1"                      value="#81154C"/>
  <color name="rouge2"                      value="#600634"/>
  <color name="pearl1"                      value="#FDF0CD"/>
  <color name="midnight1"                   value="#0E091A"/>
  <color name="midnight2"                   value="#110F1A"/>

  <!-- Global Settings -->
  <style name="current-line"                background="midnight1"/>
  <style name="current-line-number"         background="rouge2"/>
  <style name="draw-spaces"                 foreground="brass2"/>
  <style name="background-pattern"          background="brass1"/>
  <style name="line-numbers"                foreground="brass1" background="midnight2"/>
  <style name="cursor"                      foreground="brass2"/>
  <style name="selection"                   background="brass1"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"               foreground="brass1" background="brass2"/>
  <style name="bracket-mismatch"            foreground="brass1" background="rouge2"/>

  <!-- Right Margin -->
  <style name="right-margin"                foreground="midnight2" background="midnight2"/>

  <!-- Search Matching -->
  <style name="search-match"                background="dutch1"/>

  <!-- Comments -->
  <style name="def:comment"                 foreground="prussian2"/>
  <style name="def:shebang"                 foreground="prussian2" bold="true"/>
  <style name="def:doc-comment-element"     italic="true"/>

  <!-- Constants -->
  <style name="def:constant"                foreground="tyre1"/>
  <style name="def:special-char"            foreground="tyre2"/>

  <!-- Identifiers -->
  <style name="def:identifier"              foreground="prussian1"/>

  <!-- Statements -->
  <style name="def:statement"               foreground="rouge2" bold="true"/>

  <!-- Types -->
  <style name="def:type"                    foreground="phthalo2" bold="true"/>

  <!-- Others -->
  <style name="def:preprocessor"            foreground="acajou1"/>
  <style name="def:error"                   background="rouge1" bold="true"/>
  <style name="def:warning"                 background="tyre2"/>
  <style name="def:note"                    background="dutch2" bold="true"/>
  <style name="def:underlined"              italic="true" underline="single"/>

  <!-- Heading styles, uncomment to enable -->
  <!--
  <style name="def:heading0"                scale="5.0"/>
  <style name="def:heading1"                scale="2.5"/>
  <style name="def:heading2"                scale="2.0"/>
  <style name="def:heading3"                scale="1.7"/>
  <style name="def:heading4"                scale="1.5"/>
  <style name="def:heading5"                scale="1.3"/>
  <style name="def:heading6"                scale="1.2"/>
  -->

  <!-- Language specific -->
  <style name="diff:added-line"             foreground="phthalo2"/>
  <style name="diff:removed-line"           foreground="tyre2"/>
  <style name="diff:changed-line"           use-style="def:preprocessor"/>
  <style name="diff:diff-file"              use-style="def:type"/>
  <style name="diff:location"               use-style="def:statement"/>
  <style name="diff:special-case"           use-style="def:constant"/>

  <style name="xml:tags"                    foreground="phthalo1"/>
  <style name="xml:namespace"               bold="true"/>

  <style name="js:object"                   foreground="phthalo2" bold="true"/>
  <style name="js:constructors"             foreground="phthalo1"/>

  <style name="latex:display-math"          foreground="tyre2"/>
  <style name="latex:command"               foreground="phthalo2" bold="true"/>
  <style name="latex:include"               use-style="def:preprocessor"/>
  <style name="latex:special-char"          use-style="def:constant"/>

  <style name="sh:variable"                 foreground="tyre2"/>
  <style name="sh:variable-definition"      foreground="phthalo2"/>

</style-scheme>
